# ---------- 10. OOPS - PARENT + CHILD ----------
# OOPS = Real life in code - Class = Blueprint, Object = Real house
class BankAccount:  # Parent Class - Father
    def __init__(self, name, balance):  # __init__ - Save values when object made
        self.name = name  # Save name in this object
        self.balance = balance  # Save balance in this object
    def show(self):  # Method - Parent work - Show balance
        return f"{self.name} has {self.balance} rupees"

class SavingsAccount(BankAccount):  # Child Class - Son - Father is BankAccount
    def __init__(self, name, balance, interest):  # Child __init__ - 3 values
        super().__init__(name, balance)  # Call Father __init__ - Save name, balance
        self.interest = interest  # Save interest - Child own
    def add_interest(self):  # Child Method 1 - Add interest
        self.balance = self.balance + self.interest  # New balance
        return f"{self.name} new balance is {self.balance}"
    def show_interest(self):  # Child Method 2 - Show interest
        return f"{self.name} interest is {self.interest}"

a1 = BankAccount("Hyarel", 1000)  # Object - Parent Object
print(a1.show())  # Recall Function - Parent method
s1 = SavingsAccount("Priya", 1000, 100)  # Object - Child Object - 3 values
print(s1.show())  # Recall - Child uses Father method free
print(s1.add_interest())  # Recall - Child Method 1
print(s1.show_interest())  # Recall - Child Method 2

