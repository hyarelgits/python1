# ---------- 23. PYDANTIC ----------
# Pydantic = Automatic Checker / Guard - Checks data before code runs - FastAPI uses this
from pydantic import BaseModel  # Import BaseModel

class LoanForm(BaseModel):  # Pydantic Model - Blueprint with Guard
    name: str  # Name must be String
    age: int  # Age must be Int
    balance: float  # Balance must be Float

form1 = LoanForm(name="Hyarel", age=25, balance=1000.0)  # Correct data - OK
print(form1)  # Show form1
try:  # Try wrong data
    form2 = LoanForm(name="Priya", age="twenty-five", balance=1000.0)  # Wrong - Age is text
    print(form2)
except Exception as e:  # If Pydantic says error
    print("Pydantic Error - Age must be number")  # Friendly message
    print(e)  # Show real error

