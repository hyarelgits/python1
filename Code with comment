# ---------- 18. GENERATOR ----------
# Generator = Lazy giver - yield, not return - Gives one by one
def give_chai(n):  # Generator function
    for i in range(1, n+1):  # Loop 1 to n
        yield f"Chai {i}"  # Yield - Give one, wait
for chai in give_chai(3):  # Use generator
    print(chai)  # Chai 1,2,3

# ---------- 19. DATACLASS ----------
# Dataclass = Shortcut Class - No need to write __init__, Python writes for you
from dataclasses import dataclass  # Import dataclass

@dataclass  # Tell Python - Make __init__ automatically
class BankAccount2:  # Parent Class - Dataclass
    name: str  # Variable - name is String
    balance: float  # Variable - balance is Float
    def show(self):  # Method - Same as before
        return f"{self.name} has {self.balance} rupees"

@dataclass  # Dataclass for Child also
class SavingsAccount2(BankAccount2):  # Child Class - Father is BankAccount2
    interest: float  # Child extra variable
    def add_interest(self):  # Child Method 1
        self.balance = self.balance + self.interest
        return f"{self.name} new balance is {self.balance}"
    def show_interest(self):  # Child Method 2
        return f"{self.name} interest is {self.interest}"

d1 = BankAccount2("Hyarel", 1000)  # Object - Parent Dataclass Object
print(d1.show())  # Recall - Parent method
d2 = SavingsAccount2("Priya", 1000, 100)  # Object - Child Dataclass Object
print(d2.show())  # Recall - Father method free
print(d2.add_interest())  # Recall - Child Method 1
print(d2.show_interest())  # Recall - Child Method 2

